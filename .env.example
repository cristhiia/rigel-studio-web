# Copiar como .env.local para desarrollo. Nunca commitear valores reales.
# En producción se cargan en Vercel → Settings → Environment Variables.

# ── Contacto (api/contact.js) ─────────────────────────────────
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=

# ── Keelwise / Mercado Pago Suscripciones ─────────────────────
# Access token de la cuenta de Mercado Pago (usar el de prueba para sandbox).
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (Mercado Pago → Tus integraciones → Webhooks).
MP_WEBHOOK_SECRET=

# Supabase del proyecto que usa la app Keelwise (solo server).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Precio mensual en pesos que se cobra (número, sin símbolos). Ej: 15000
# También se muestra en la landing (se expone al frontend en el build: no es secreto).
KEELWISE_PRICE_ARS=
# Link de la APK. URL pública o "supabase-storage://bucket/ruta/keelwise.apk"
# para generar un link firmado de 10 minutos server-side.
KEELWISE_APK_URL=
# URL pública del sitio, sin barra final. Ej: https://rigelstudio.com.ar
SITE_URL=
