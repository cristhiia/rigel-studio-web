# Copiar como .env.local para desarrollo. Nunca commitear valores reales.
# En producción se cargan en Vercel → Settings → Environment Variables.

# ── Contacto (api/contact.js) ─────────────────────────────────
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=

# ── Billing multiproducto (api/billing/*, ver docs/billing.md) ─
# Access token de Mercado Pago (usar el de prueba para sandbox). Secreto.
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (Mercado Pago → Tus integraciones → Webhooks). Secreto.
MP_WEBHOOK_SECRET=

# Supabase del proyecto que usan las apps para Auth (solo server). Secreto.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio, sin barra final. Ej: https://rigelstudio.com.ar
SITE_URL=

# Emails que pueden ver /admin, separados por comas.
ADMIN_EMAILS=

# Opcional: bucket privado de Supabase Storage para las entregas 'apk'.
# Por defecto: apks
BILLING_STORAGE_BUCKET=

# Login del panel /admin: URL y anon key del MISMO proyecto que SUPABASE_URL.
# Son públicas (van al navegador). Sin ellas, /admin redirige a la home.
VITE_BILLING_SUPABASE_URL=
VITE_BILLING_SUPABASE_ANON_KEY=

# Respaldo del precio: solo se usa si billing_products.price_ars está vacío.
# Formato <SLUG>_PRICE_ARS (número, sin símbolos). Se expone al build de la landing.
KEELWISE_PRICE_ARS=
